{
  "uid": "commerce-overview",
  "title": "Commerce Overview",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {"from": "now-30m", "to": "now"},
  "panels": [
    {"id": 1, "title": "Requests per second", "type": "timeseries", "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8}, "targets": [{"refId": "A", "expr": "sum by (application) (rate(http_server_requests_seconds_count[5m]))", "legendFormat": "{{application}}"}]},
    {"id": 2, "title": "95th percentile request latency", "type": "timeseries", "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8}, "fieldConfig": {"defaults": {"unit": "s"}}, "targets": [{"refId": "A", "expr": "histogram_quantile(0.95, sum by (application, le) (rate(http_server_requests_seconds_bucket[5m])))", "legendFormat": "{{application}}"}]},
    {"id": 3, "title": "JVM memory used", "type": "timeseries", "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8}, "fieldConfig": {"defaults": {"unit": "bytes"}}, "targets": [{"refId": "A", "expr": "sum by (application) (jvm_memory_used_bytes)", "legendFormat": "{{application}}"}]},
    {"id": 4, "title": "Outbox events published per second", "type": "timeseries", "gridPos": {"x": 12, "y": 8, "w": 12, "h": 8}, "targets": [{"refId": "A", "expr": "sum by (application) (rate(commerce_outbox_published_total[5m]))", "legendFormat": "{{application}}"}]},
    {"id": 5, "title": "Consumer failures (5 minute increase)", "type": "timeseries", "gridPos": {"x": 0, "y": 16, "w": 12, "h": 8}, "targets": [{"refId": "A", "expr": "sum by (application) (increase(commerce_kafka_consumer_failures_total[5m]))", "legendFormat": "{{application}}"}]},
    {"id": 6, "title": "Payment failures (5 minute increase)", "type": "timeseries", "gridPos": {"x": 12, "y": 16, "w": 12, "h": 8}, "targets": [{"refId": "A", "expr": "sum(increase(commerce_payments_failures_total[5m]))", "legendFormat": "Failed payments"}]}
  ]
}
