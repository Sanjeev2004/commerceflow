# Copy to .env before `docker compose up`. Replace these local defaults before a shared or public machine.
POSTGRES_USER=commerce
POSTGRES_PASSWORD=changeme
# At least 32 random ASCII characters. Example generation: openssl rand -hex 32
JWT_SECRET=please-change-this-to-a-long-random-string!!
GRAFANA_PASSWORD=admin
# Optional one-time bootstrap admin. Leave both blank to disable.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-admin-password
